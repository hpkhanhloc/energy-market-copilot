# Copy to .env and fill in. .env is git-ignored.
FINGRID_API_KEY=
ENTSOE_API_KEY=
# LLM for the narrative step. Pydantic AI model string: "<provider>:<model>".
# Examples: anthropic:claude-sonnet-5 | openai:gpt-5 | ollama:llama3.3
# Provider key goes in the matching env var: ANTHROPIC_API_KEY / OPENAI_API_KEY.
COPILOT_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
